{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/amazon-q/refs/heads/main/json-structure/amazon-q-openapi-message-structure.json",
  "description": "Message schema from openapi",
  "type": "object",
  "properties": {
    "messageId": {
      "type": "string",
      "description": "The unique identifier of the message."
    },
    "body": {
      "type": "string",
      "description": "The content of the message."
    },
    "type": {
      "type": "string",
      "enum": [
        "USER",
        "SYSTEM"
      ],
      "description": "The type of message."
    },
    "time": {
      "type": "datetime",
      "description": "The time the message was sent."
    }
  },
  "name": "Message"
}